{
  "info": {
    "_postman_id": "a886192c-0908-4f4f-8f83-1a954c11b671",
    "name": "Edabip Prathibha API",
    "description": "Plan and current subscription endpoints. Set baseUrl and customerId before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "planId", "value": "1" },
    { "key": "subscriptionId", "value": "1" },
    { "key": "customerId", "value": "1" }
  ],
  "item": [
    {
      "name": "Create plan",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Business\",\n  \"price\": 49.99,\n  \"userLimit\": 25,\n  \"storageLimitGb\": 100,\n  \"reportsPerMonth\": 500,\n  \"support\": \"Priority email\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/plans"
      }
    },
    {
      "name": "List plans",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/plans" }
    },
    {
      "name": "Get plan",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/plans/{{planId}}" }
    },
    {
      "name": "Get current subscription",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/subscription?customerId={{customerId}}" }
    },
    {
      "name": "Create subscription",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": {{customerId}},\n  \"planId\": {{planId}},\n  \"billingCycle\": \"MONTHLY\",\n  \"currentPeriodStart\": \"2026-10-01\",\n  \"currentPeriodEnd\": \"2026-11-01\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/subscription"
      }
    },
    {
      "name": "Get subscription",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/subscription/{{subscriptionId}}" }
    }
  ]
}
